# Образ склада билетов (flights-tickets): Rust-сервис `tickets/` — текущее состояние серий
# X→ANY из озера коллектора в Postgres (контейнер tickets-db в том же compose), выборки
# для планировщика (Arrow IPC в схеме озера). Внутренний порт 8002, наружу не публикуется.
# Файлы озера получает пушем от коллектора и сверкой через его /v1/lake/* (COLLECTOR_URL).

# ---- сборка -----------------------------------------------------------------
FROM rust:1-slim-bookworm AS build

WORKDIR /src
# zstd/lz4 (parquet) собирают C-код — нужен компилятор.
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY tickets/Cargo.toml tickets/Cargo.lock ./
COPY tickets/src ./src
RUN cargo build --release --locked && strip target/release/flights-tickets

# ---- рантайм ----------------------------------------------------------------
FROM debian:bookworm-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/target/release/flights-tickets /usr/local/bin/flights-tickets

ENV PORT=8002

RUN useradd --create-home --uid 1000 app
USER app

EXPOSE 8002
CMD ["flights-tickets"]
