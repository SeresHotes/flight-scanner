# Образ планировщика (flights-planner): Rust-сервис `planner/` — HTTP /api/* и фоновая
# джоба стыковки. Серии билетов берёт у коллектора (COLLECTOR_URL, deploy/Dockerfile.collector).
# Раздача статики и TLS — на соседнем контейнере caddy (deploy/Dockerfile.web),
# сюда приходит уже только /api/* через reverse-proxy.

# ---- сборка -----------------------------------------------------------------
FROM rust:1-slim-bookworm AS build

WORKDIR /src
# zstd и mimalloc собирают C-код — нужен компилятор.
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY planner/Cargo.toml planner/Cargo.lock ./
COPY planner/src ./src
RUN cargo build --release --locked && strip target/release/flights-planner

# ---- рантайм ----------------------------------------------------------------
FROM debian:bookworm-slim

WORKDIR /app
# Сертификаты — для прямого HTTPS к Travelpayouts (локальный режим без коллектора).
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/target/release/flights-planner /usr/local/bin/flights-planner
# Статичные справочники планировщика (имена городов, координаты для переезда к соседу).
COPY core/geo.json core/city_names.json ./core/
# Прод-compose едет вместе с образом: run.sh на VM достаёт его отсюда при каждом
# обновлении, поэтому состав контейнеров меняется обычным деплоем (без cloud-init).
COPY deploy/compose.prod.yml ./deploy/compose.prod.yml

# Всё горячее состояние — на смонтированном томе /app/data (plan_jobs/ + plan_flights/ +
# data/airport_network.json для автокомплита). Пути совпадают с дефолтами (cwd=/app).
ENV FLIGHT_DB=/app/data/flights.db \
    PORT=8000

# Непривилегированный пользователь с фиксированным uid 1000 — том /app/data
# монтируется снаружи и chown-ится под этот uid в cloud-init (run.sh).
RUN useradd --create-home --uid 1000 app && mkdir -p /app/data && chown -R app /app
USER app

EXPOSE 8000
CMD ["flights-planner"]
