      "uid": "flights-clickhouse"
     },
     "editorType": "sql",
     "rawSql": "SELECT ts AS time, crawler_fresh AS \"свежие\", crawler_pairs AS \"всего пар\", crawler_refresh AS \"из них старше суток (обновляются)\", crawler_stale AS \"устарели\", crawler_missing AS \"нет данных\", crawler_errors AS \"ошибка источника\", crawler_pass_progress AS \"проход\", cities AS \"городов\", series_age_p50_h AS \"медиана\", series_age_p95_h AS \"p95\", series_age_max_h AS \"максимум\", pages_app_1m + pages_crawl_1m AS \"всего запросов\", pages_app_1m AS \"запросы приложения\", pages_crawl_1m AS \"запросы фона\", rate_per_minute AS \"лимит в минуту\", queued_crawl AS \"фон, окон дат\", queued_app AS \"приложение, заданий\", crawler_queued_pages_est AS \"фон, оценка страниц\", http_429_1m AS \"429\", source_errors_1m AS \"ошибка в ответе GraphQL\", network_errors_1m AS \"сеть / HTTP 5xx\", lake_write_errors_1m AS \"запись в озеро\", series_app_1m + series_crawl_1m AS \"выборок\", tickets_1m AS \"билетов\", cpu_pct AS \"CPU\", mem_pct AS \"RAM\", disk_used_pct AS \"диск\", lake_bytes / 1073741824 AS \"озеро (tickets/)\", bucket_bytes / 1073741824 AS \"весь бакет\", lake_max_bytes / 1073741824 AS \"порог ретеншна\", lake_files AS \"файлов\", files_deleted_1m AS \"удалено за минуту\" FROM flights.ops_metrics WHERE $__timeFilter(ts) ORDER BY ts",
     "queryType": "timeseries",
     "refId": "A"
    }
   ],
