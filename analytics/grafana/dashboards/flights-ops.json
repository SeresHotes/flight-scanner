  {
   "id": 9,
   "title": "Проход по календарю: города по дням вылета (сейчас)",
   "type": "barchart",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "flights-clickhouse"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "flights-clickhouse"
     },
     "editorType": "sql",
     "rawSql": "WITH (SELECT max(pass_started) FROM flights.coverage) AS ps SELECT formatDateTime(g.day, '%d.%m') AS \"день\", countIf(cv.error = 0 AND cv.fetched_at >= ps) AS \"обработаны в этом проходе\", countIf(cv.error = 0 AND NOT ifNull(cv.fetched_at >= ps, 0)) AS \"ждут (с прошлого прохода)\", countIf(cv.error = 1) AS \"ошибка источника\", countIf(cv.origin IS NULL) AS \"нет данных\" FROM (SELECT o.origin AS origin, today() + n.number AS day FROM (SELECT DISTINCT origin FROM flights.coverage WHERE NOT error) AS o CROSS JOIN numbers(181) AS n) AS g LEFT JOIN (SELECT origin, day, fetched_at, error FROM flights.coverage WHERE day >= today()) AS cv ON cv.origin = g.origin AND cv.day = g.day GROUP BY g.day ORDER BY g.day SETTINGS join_use_nulls = 1",
     "queryType": "table",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 90,
      "lineWidth": 0,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {
