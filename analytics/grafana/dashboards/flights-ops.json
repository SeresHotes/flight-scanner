  {
   "id": 10,
   "title": "Когда получены данные: пар «город × день» по часу получения",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "flights-clickhouse"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "flights-clickhouse"
     },
     "editorType": "sql",
     "rawSql": "SELECT toStartOfHour(fetched_at) AS time, countIf(dateDiff('day', today(), day) <= 14) AS \"вылет через 0–14 дн.\", countIf(dateDiff('day', today(), day) BETWEEN 15 AND 60) AS \"15–60 дн.\", countIf(dateDiff('day', today(), day) > 60) AS \"61–180 дн.\" FROM flights.coverage WHERE day >= today() AND NOT error AND $__timeFilter(fetched_at) GROUP BY time ORDER BY time",
     "queryType": "timeseries",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 0,
      "showPoints": "never",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "Распределение текущих данных по времени получения: у каждой пары «город × день» на горизонте берётся последний раз, когда её скачали, и считается, сколько пар пришлось на каждый час (цвет — дальность даты вылета). Проход идёт по календарю, поэтому цвета сменяют друг друга: сначала ближние даты, потом дальние. Снимок покрытия — раз в 10 мин."
  },
