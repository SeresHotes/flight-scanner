   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "flights-clickhouse"
     },
     "editorType": "sql",
     "rawSql": "SELECT toStartOfHour(fetched_at) AS time, countIf(dateDiff('day', today(), day) <= 14) AS \"вылет через 0–14 дн.\", countIf(dateDiff('day', today(), day) BETWEEN 15 AND 60) AS \"15–60 дн.\", countIf(dateDiff('day', today(), day) > 60) AS \"61–180 дн.\" FROM flights.coverage WHERE day >= today() AND NOT error AND $__timeFilter(fetched_at) GROUP BY time ORDER BY time",
     "queryType": "timeseries",
     "refId": "A"
    }
   ],
