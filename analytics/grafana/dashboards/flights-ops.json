     "editorType": "sql",
     "rawSql": "SELECT origin AS \"город\", round(max(age_h), 1) AS \"макс. возраст, ч\", round(avg(age_h), 1) AS \"средний, ч\", count() AS \"дней\", sum(tickets) AS \"билетов\" FROM flights.coverage WHERE day >= today() AND NOT error GROUP BY origin ORDER BY max(age_h) DESC LIMIT 20",
