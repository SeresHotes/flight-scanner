  {
   "id": 10,
   "title": "Свежесть по дальности даты вылета (недели от сегодня)",
   "type": "barchart",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "flights-clickhouse"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "flights-clickhouse"
     },
     "editorType": "sql",
     "rawSql": "SELECT concat('нед. ', toString(intDiv(dateDiff('day', today(), day), 7))) AS week, round(avg(age_h), 1) AS \"средний возраст, ч\", round(max(age_h), 1) AS \"максимум, ч\" FROM flights.coverage WHERE day >= today() AND NOT error GROUP BY intDiv(dateDiff('day', today(), day), 7) ORDER BY intDiv(dateDiff('day', today(), day), 7)",
     "queryType": "table",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 2,
      "showPoints": "never"
     },
     "unit": "h"
    },
    "overrides": []
   },
   "options": {
    "orientation": "vertical",
    "xField": "week",
    "showValue": "never"
   }
  },
  {
   "id": 11,
   "title": "Самые старые данные по городам (топ 20)",
   "type": "table",
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "flights-clickhouse"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "flights-clickhouse"
     },
     "editorType": "sql",
     "rawSql": "SELECT origin AS \"город\", round(max(age_h), 1) AS \"макс. возраст, ч\", count() AS \"дней\", sum(tickets) AS \"билетов\" FROM flights.coverage WHERE day >= today() AND NOT error GROUP BY origin ORDER BY max(age_h) DESC LIMIT 20",
     "queryType": "table",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
