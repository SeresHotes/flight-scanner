   "options": {}
  },
  {
   "id": 12,
   "title": "Запас свежести по дням вылета на 180 дней, p95 городов (7 − возраст в сутках)",
   "type": "barchart",
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "flights-clickhouse"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "flights-clickhouse"
     },
     "editorType": "sql",
     "rawSql": "SELECT formatDateTime(d.day, '%d.%m') AS \"день\", c.p95_left AS \"p95 городов\", c.avg_left AS \"среднее по городам\", c.min_left AS \"худший город\", ifNull(c.cities, 0) AS \"городов\" FROM (SELECT today() + number AS day FROM numbers(180)) AS d LEFT JOIN (SELECT day, round(7 - quantile(0.95)(age_h) / 24, 2) AS p95_left, round(7 - avg(age_h) / 24, 2) AS avg_left, round(7 - max(age_h) / 24, 2) AS min_left, count() AS cities FROM flights.coverage WHERE day >= today() AND NOT error GROUP BY day) AS c ON c.day = d.day ORDER BY d.day SETTINGS join_use_nulls = 1",
     "queryType": "table",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 80,
      "lineWidth": 0
     },
     "color": {
      "mode": "thresholds"
     },
     "softMax": 7,
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0
       },
       {
        "color": "green",
        "value": 4
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "среднее по городам"
      },
      "properties": [
       {
        "id": "custom.hideFrom",
        "value": {
         "viz": true,
         "legend": true,
         "tooltip": false
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "худший город"
      },
      "properties": [
       {
        "id": "custom.hideFrom",
        "value": {
         "viz": true,
         "legend": true,
         "tooltip": false
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "городов"
      },
      "properties": [
       {
        "id": "custom.hideFrom",
        "value": {
         "viz": true,
         "legend": true,
         "tooltip": false
        }
       }
      ]
     }
    ]
   },
   "options": {
    "orientation": "vertical",
    "xField": "день",
    "showValue": "never",
    "xTickLabelSpacing": 100,
    "barWidth": 0.9,
    "tooltip": {
     "mode": "multi"
    },
    "legend": {
     "showLegend": false
    }
   },
   "description": "Столбец — 95-й перцентиль по городам: у 95 % городов этого дня данные свежее. Горизонт сборщика — 180 дней от сегодня. 7 — только что обновлено, минус 1 за каждые сутки. ≥ 4 — в пределах 72 ч (цель до 60 дней вперёд), 0…4 — до недели (цель для дальних дат), < 0 — старше недели. Пустой день — данных ещё нет; пары с ошибкой источника не учитываются."
  },
