<clickhouse>
  <!-- Креды и URL бакета flights для s3()-вьюх базы `flights` (init-flights.sql).
       Рендерится analytics/setup.sh из terraform output этого репозитория и кладётся
       на аналитическую VM в /opt/analytics/clickhouse/config.d/named_collections_flights.xml
       рядом с коллекциями Market Data (их файл не трогаем). -->
  <named_collections>
    <flights_tickets>
      <url>https://storage.yandexcloud.net/__BUCKET__/tickets/date=*/origin=*/*.parquet</url>
      <access_key_id>__S3_KEY__</access_key_id>
      <secret_access_key>__S3_SECRET__</secret_access_key>
      <format>Parquet</format>
    </flights_tickets>
    <flights_ops_metrics>
      <url>https://storage.yandexcloud.net/__BUCKET__/ops_metrics/date=*/*.parquet</url>
      <access_key_id>__S3_KEY__</access_key_id>
      <secret_access_key>__S3_SECRET__</secret_access_key>
      <format>Parquet</format>
    </flights_ops_metrics>
    <flights_coverage>
      <url>https://storage.yandexcloud.net/__BUCKET__/coverage/latest.parquet</url>
      <access_key_id>__S3_KEY__</access_key_id>
      <secret_access_key>__S3_SECRET__</secret_access_key>
      <format>Parquet</format>
    </flights_coverage>
  </named_collections>
</clickhouse>
