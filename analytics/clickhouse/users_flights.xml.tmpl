<clickhouse>
    <!-- Пользователь ClickHouse для источника данных Grafana «ClickHouse Flights».
         Отдельный файл users.d/flights.xml на аналитической VM: пользователь `grafana`
         Market Data и его файл не трогаем. ClickHouse наружу не публикуется, пароль —
         внутренний (рендерит analytics/setup.sh, он же кладёт его в datasource Grafana). -->
    <users>
        <flights_grafana>
            <password>__CH_PASSWORD__</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON flights.*</query>
                <query>GRANT NAMED COLLECTION ON *</query>
                <query>GRANT S3 ON *.*</query>
                <query>GRANT CREATE TEMPORARY TABLE ON *.*</query>
            </grants>
        </flights_grafana>
    </users>
</clickhouse>
