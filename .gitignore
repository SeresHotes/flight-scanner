# Poetry
poetry.lock

# Environment
.env

# Data files (только корневой каталог данных; НЕ frontend/src/data и т.п.)
/data/
*.json
!tests/fixtures/*.json
# координаты городов/аэропортов для переезда в соседний город (scripts/build_geo.py)
!/core/geo.json
# имена городов для выдачи планировщика (scripts/build_city_names.py)
!/core/city_names.json
# дашборды Grafana (analytics/grafana/build_dashboard.py → setup.sh заливает в Grafana)
!/analytics/grafana/dashboards/*.json
*.csv
# генерируется build_web_data.py
web/data.js
# сид для Object Storage (собирается deploy/make-seed.sh из data/)
/seed/

# ...но JSON-конфиги фронтенда нужны в репозитории (перебиваем *.json выше)
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/tsconfig.app.json
!frontend/tsconfig.node.json

# Rust (planner/): артефакты cargo
/planner/target/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
