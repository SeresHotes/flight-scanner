#cloud-config
# Terraform templatefile обрабатывает только последовательности вида "доллар+фигурные".
# Единственная реальная подстановка — env_b64. Shell-переменные пишем $VAR / $(...).
#
# Состав контейнеров (planner + collector + web) описан НЕ здесь, а в репозитории:
# deploy/compose.prod.yml едет внутри образа planner, run.sh копирует его в
# /opt/flights/docker-compose.yml при каждом обновлении. cloud-init выполняется один
# раз при создании VM, поэтому всё, что должно меняться деплоем, живёт в образах.
write_files:
  # Секреты и параметры: env_file для контейнеров и переменные подстановки compose.
  - path: /opt/flights/.env
    permissions: '0600'
    encoding: b64
    content: ${env_b64}

  # Засев горячего тома из Object Storage при первом бутe (идемпотентно).
  - path: /opt/flights/seed.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      set -a; source /opt/flights/.env; set +a
      mkdir -p /opt/flights/data
      if [ -f /opt/flights/data/airport_network.json ]; then
        echo "seed: данные уже на месте, пропуск"
        exit 0
      fi
      echo "seed: sync s3://$S3_BUCKET/seed -> /opt/flights/data"
      docker run --rm \
        -e AWS_ACCESS_KEY_ID="$S3_ACCESS_KEY" \
        -e AWS_SECRET_ACCESS_KEY="$S3_SECRET_KEY" \
        -v /opt/flights/data:/data \
        amazon/aws-cli:latest \
        --endpoint-url "$S3_ENDPOINT" --region "$S3_REGION" \
        s3 sync "s3://$S3_BUCKET/seed" /data

  # Логин в реестр по IAM-токену SA этой VM, засев, compose из образа, поднятие/обновление
  # стека. Тот же скрипт запускает и таймер обновления — поэтому он и self-heal (если
  # образ ещё не был запушен на первом бутe), и авто-апдейт (pull свежих образов).
  - path: /opt/flights/run.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      set -a; source /opt/flights/.env; set +a
      TOKEN=$(curl -s -H "Metadata-Flavor: Google" \
        "http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token" \
        | python3 -c "import sys, json; print(json.load(sys.stdin)['access_token'])")
      echo "$TOKEN" | docker login --username iam --password-stdin cr.yandex
      /opt/flights/seed.sh
      # Контейнеры работают под непривилегированным uid 1000 — том должен быть его
      # (сид качает root-контейнер aws-cli). Иначе SQLite не создать: "unable to open database file".
      # Один раз (маркер .owned): на томе больше миллиона файлов локального озера котировок,
      # рекурсивный chown с холодным кэшем inode шёл десятки минут при каждом обновлении.
      if [ ! -e /opt/flights/data/.owned ]; then
        chown -R 1000:1000 /opt/flights/data && touch /opt/flights/data/.owned
      fi
      cd /opt/flights
      # Каждый деплой оставлял старый образ (после pull :latest он теряет тег) — за
      # ~70 деплоев они забили диск 19 ГБ, pull падал "no space left on device", и
      # прод молча застревал на старой версии. Удаляем только бестеговые (dangling):
      # текущие :latest и aws-cli остаются. До pull — чтобы цикл сам вылечился после
      # такого сбоя, после up -d — чтобы сразу убрать только что вытесненный образ.
      # Сбой уборки не должен валить деплой.
      docker image prune -f || true
      # Прод-compose — из свежего образа planner (deploy/compose.prod.yml в репо).
      docker pull "$PLANNER_IMAGE"
      CID=$(docker create "$PLANNER_IMAGE")
      docker cp "$CID:/app/deploy/compose.prod.yml" /opt/flights/docker-compose.yml.new
      docker rm "$CID" >/dev/null
      mv /opt/flights/docker-compose.yml.new /opt/flights/docker-compose.yml
      docker compose pull
      docker compose up -d --remove-orphans
      docker image prune -f || true

  - path: /etc/systemd/system/flights.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Flight Scanner (planner + collector + Caddy) via docker compose
      After=docker.service network-online.target
      Requires=docker.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/opt/flights/run.sh
      # На первом бутe образ мог быть ещё не запушен — повторяем, таймер добьёт.
      Restart=on-failure
      RestartSec=30

      [Install]
      WantedBy=multi-user.target

  # Периодический pull свежих образов + docker compose up -d (self-heal + авто-деплой).
  - path: /etc/systemd/system/flights-update.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Pull latest flights images and reconcile compose
      After=docker.service network-online.target
      Requires=docker.service

      [Service]
      Type=oneshot
      ExecStart=/opt/flights/run.sh

  - path: /etc/systemd/system/flights-update.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Periodic flights image update

      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=2min

      [Install]
      WantedBy=timers.target

runcmd:
  - curl -fsSL https://get.docker.com | sh
  - systemctl daemon-reload
  - systemctl enable --now flights.service
  - systemctl enable --now flights-update.timer
